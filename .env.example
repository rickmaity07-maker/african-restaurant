# ── Database (required) ──────────────────────────────────────────────
DATABASE_URL=

# ── Auth.js / NextAuth core (required) ───────────────────────────────
AUTH_SECRET=                          # generate with: npx auth secret
NEXTAUTH_URL=http://localhost:3000    # real domain in production

# ── Google OAuth login (optional — omit to disable Google sign-in) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth login (optional — omit to disable Facebook sign-in)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Resend — transactional email (required to actually send emails;
#    app degrades gracefully without it, but no emails go out) ───────
RESEND_API_KEY=
EMAIL_FROM="Karmel Café & Restaurant <reservations@yourdomain.com>"
ADMIN_EMAIL=                          # receives new-reservation notifications

# ── Firebase — phone number OTP verification ─────────────────────────
# Client SDK config (public, safe to expose — Firebase Console > Project
# Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK config (server-only secret — Firebase Console > Project
# Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences from the downloaded service account JSON;
# the app converts them to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Upstash Redis — rate limiting (REQUIRED in production; the app will
#    refuse to start in production without these — see DEPLOYMENT.md) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
